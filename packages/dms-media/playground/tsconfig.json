{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@antelopejs/interface-dms": ["./node_modules/@antelopejs/interface-dms"],
      "@antelopejs/interface-dms/*": [
        "./node_modules/@antelopejs/interface-dms/dist/*"
      ]
    }
  },
  "include": ["./src/**/*.ts", "./antelope.config.ts"]
}
