{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["./src/**/*.ts", "./antelope.config.ts"]
}
