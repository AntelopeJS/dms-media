{
  "name": "@antelopejs/dms-media",
  "version": "0.6.1",
  "description": "Media library for the AntelopeJS DMS: uploads, folders with per-folder permissions, image sizes and light editing, with a Finder-style explorer.",
  "keywords": [
    "antelopejs",
    "assets",
    "dms",
    "dms-module",
    "file-explorer",
    "media"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/media",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-media/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-media.git",
    "directory": "packages/dms-media"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-media build && rimraf dist && tsc",
    "dev:frontend": "pnpm frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "typecheck": "pnpm --filter @antelopejs/interface-dms-media build && tsc --noEmit",
    "test": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && ajs module test .",
    "test:unit": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/unit ajs module test .",
    "test:integration": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/integration ajs module test .",
    "test:reload": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && node --test --test-force-exit tests/hot-reload.test.mjs",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "release": "pnpm --filter @antelopejs/interface-dms-media build && pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "test:exports": "node --test tests/package-exports.test.mjs"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-f2a99b5.tgz",
    "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-639f38b.tgz",
    "@antelopejs/interface-core": "file:../../.campaign/tgz/antelopejs-interface-core-f7df541.tgz",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-e0787e6.tgz",
    "@antelopejs/interface-dms-media": ">=0.3.0 <0.4.0",
    "@antelopejs/interface-file-storage": ">=0.1.6 <1.0.0",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.4",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": "file:../../.campaign/tgz/antelopejs-core-184eb90.tgz",
    "@antelopejs/dms": "file:../../.campaign/tgz/antelopejs-dms-80e4dc1.tgz",
    "@antelopejs/dms-frontend": "file:../../.campaign/tgz/antelopejs-dms-frontend-ee4e931.tgz",
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-d8a868f.tgz",
    "@antelopejs/tooling-configs": "file:../../.campaign/tgz/antelopejs-tooling-configs-a423d41.tgz",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-media"
    ],
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
