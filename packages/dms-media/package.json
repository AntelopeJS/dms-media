{
  "name": "@antelopejs/dms-media",
  "version": "0.4.0",
  "description": "Media library for the AntelopeJS DMS: uploads, folders with per-folder permissions, image sizes and light editing, with a Finder-style explorer.",
  "keywords": [
    "antelopejs",
    "assets",
    "dms",
    "dms-module",
    "file-explorer",
    "media"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/media",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-media/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-media.git",
    "directory": "packages/dms-media"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-media build && rimraf dist && tsc",
    "dev:frontend": "pnpm frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint && antelopejs-check-interface-ranges",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "test": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && ajs module test .",
    "test:unit": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/unit ajs module test .",
    "test:integration": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/integration ajs module test .",
    "test:reload": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && node --test --test-force-exit tests/hot-reload.test.mjs",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "release": "pnpm --filter @antelopejs/interface-dms-media build && pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "test:exports": "node --test tests/package-exports.test.mjs"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-dms": ">=0.7.2 <1.0.0",
    "@antelopejs/interface-dms-media": ">=0.2.2 <0.3.0",
    "@antelopejs/interface-file-storage": ">=0.1.4 <1.0.0",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.4",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.16.0 <2",
    "@antelopejs/dms": ">=0.9.3 <1.0.0",
    "@antelopejs/dms-frontend": "0.6.3",
    "@antelopejs/tooling-configs": ">=0.0.9 <1.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-media"
    ],
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
