{
  "git": {
    "commitMessage": "chore(release): @antelopejs/dms-media v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/dms-media v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm --filter @antelopejs/interface-dms-media build",
      "pnpm --dir ../.. run lint",
      "pnpm --dir ../.. run format:check"
    ],
    "after:bump": [
      "node scripts/check-docs-module-version.mts --write",
      "git add -u ../..",
      "git add CHANGELOG.md"
    ]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
