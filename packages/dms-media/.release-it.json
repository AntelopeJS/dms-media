{
  "git": {
    "commitMessage": "chore(release): @antelopejs/dms-media v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/dms-media v${version}"
  },
  "hooks": {
    "before:init": ["pnpm lint"],
    "after:bump": "git add CHANGELOG.md"
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
