{
  "name": "@antelopejs/interface-dms-media",
  "version": "0.4.0",
  "description": "AntelopeJS interface for the DMS media module: declare asset fields and the media folders bound to them from any module",
  "keywords": [
    "antelopejs",
    "assets",
    "dms",
    "interface",
    "media"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/media/extending",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-media/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-media.git",
    "directory": "packages/interface-dms-media"
  },
  "files": [
    "LICENSE",
    "docs",
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run typecheck && pnpm run build && pnpm --dir ../.. run lint && pnpm run check:exports && release-it",
    "prepack": "pnpm run build",
    "check:exports": "node scripts/check-exports.mjs",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antelopejs/interface-api": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.2 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.0 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.0 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-dms": ">=0.14.0 <0.15.0",
    "@antelopejs/tooling-configs": "^0.7.1",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-api": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-dms": ">=0.14.0 <0.15.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {}
}
