{
  "name": "@antelopejs/dms-media",
  "version": "0.0.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-media.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "src",
    "tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev:frontend": "pnpm frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint",
    "typecheck": "tsc -p tsconfig.json",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "test": "pnpm run build && ajs module test .",
    "test:unit": "pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/unit ajs module test .",
    "test:integration": "pnpm run build && DMS_MEDIA_TEST_DIR=dist/test/integration ajs module test .",
    "release": "pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-dms": ">=0.0.1 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.3 <1.0.0",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.4",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": "1.4.11",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "mongodb-memory-server-core",
      "esbuild"
    ]
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/dms-media"
    ],
    "test": "src/test/antelope.test.ts"
  }
}
