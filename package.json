{
  "name": "dms-media-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-media build",
    "dev": "pnpm --filter @antelopejs/dms-media dev",
    "frontend:dev": "pnpm --filter @antelopejs/dms-media frontend:dev",
    "typecheck": "pnpm --dir packages/interface-dms-media typecheck && pnpm --dir packages/dms-media typecheck",
    "lint": "oxlint && pnpm --dir packages/dms-media/frontend-vue lint && node packages/dms-media/scripts/check-locales.mts && node packages/dms-media/scripts/check-renderer-range.mts && node packages/dms-media/scripts/check-docs-module-version.mts && pnpm --dir packages/dms-media exec antelopejs-check-interface-ranges",
    "lint:fix": "oxlint --fix && pnpm --dir packages/dms-media/frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir packages/dms-media/frontend-vue format",
    "knip": "pnpm --dir packages/interface-dms-media knip && pnpm --dir packages/dms-media knip",
    "test": "pnpm --dir packages/dms-media/frontend-vue test",
    "test:frontend": "pnpm --dir packages/dms-media test:frontend",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.2.18",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "mongodb-memory-server-core",
      "esbuild"
    ],
    "overrides": {
      "@antelopejs/interface-database": "0.3.0",
      "@antelopejs/interface-api": "0.2.0",
      "@antelopejs/interface-api-util": "0.3.0",
      "@antelopejs/interface-database-decorators": "0.2.0",
      "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-d8a868f.tgz",
      "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-14e671d.tgz",
      "@antelopejs/dms>@antelopejs/interface-file-storage": "0.1.6",
      "@antelopejs/interface-core": "0.4.0",
      "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-14e671d.tgz"
    }
  },
  "antelopeJs": {
    "docs": {
      "standard": true
    }
  }
}
