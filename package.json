{
  "name": "dms-media-workspace",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-media build",
    "dev": "pnpm --filter @antelopejs/dms-media dev",
    "frontend:dev": "pnpm --filter @antelopejs/dms-media frontend:dev",
    "lint": "pnpm --filter @antelopejs/interface-dms-media lint && pnpm --filter @antelopejs/dms-media lint",
    "typecheck": "pnpm --filter @antelopejs/interface-dms-media typecheck && pnpm --filter @antelopejs/dms-media typecheck",
    "knip": "pnpm --filter @antelopejs/interface-dms-media knip && pnpm --filter @antelopejs/dms-media knip",
    "test": "pnpm --filter @antelopejs/dms-media test",
    "test:frontend": "pnpm --filter @antelopejs/dms-media test:frontend"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": ">=0.0.7 <1.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "mongodb-memory-server-core",
      "esbuild"
    ],
    "overrides": {
      "tinypool@<2.1.2": "^2.1.2",
      "undici@>=6.0.0 <6.28.1": "^6.28.1"
    }
  }
}
