{
  "name": "dms-media-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-media build",
    "dev": "pnpm --filter @antelopejs/dms-media dev",
    "frontend:dev": "pnpm --filter @antelopejs/dms-media frontend:dev",
    "typecheck": "pnpm --dir packages/interface-dms-media typecheck && pnpm --dir packages/dms-media typecheck",
    "lint": "oxlint && pnpm --dir packages/dms-media/frontend-vue lint && node packages/dms-media/scripts/check-locales.mts && node packages/dms-media/scripts/check-renderer-range.mts && node packages/dms-media/scripts/check-docs-module-version.mts && node packages/dms-media/scripts/check-docs-http-surface.mts",
    "lint:fix": "oxlint --fix && pnpm --dir packages/dms-media/frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir packages/dms-media/frontend-vue format",
    "knip": "pnpm --dir packages/interface-dms-media knip && pnpm --dir packages/dms-media knip",
    "test": "pnpm --dir packages/dms-media/frontend-vue test",
    "test:frontend": "pnpm --dir packages/dms-media test:frontend",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "checks:prepare": "pnpm --dir packages/interface-dms-media build",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.7.1",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "mongodb-memory-server-core",
      "esbuild"
    ],
    "overrides": {
      "@antelopejs/dms": "file:.tgz-deps/antelopejs-dms-5e267c7.tgz",
      "@antelopejs/dms>@antelopejs/interface-api": "0.3.3",
      "@antelopejs/dms>@antelopejs/interface-api-util": "0.3.2",
      "@antelopejs/dms>@antelopejs/interface-core": "0.5.1",
      "@antelopejs/dms>@antelopejs/interface-data-api": "0.8.0",
      "@antelopejs/dms>@antelopejs/interface-database": "0.4.0",
      "@antelopejs/dms>@antelopejs/interface-database-decorators": "0.5.2",
      "@antelopejs/dms>@antelopejs/interface-dms": "0.14.0",
      "@antelopejs/dms>@antelopejs/interface-file-storage": "0.1.8"
    }
  },
  "antelopeJs": {
    "docs": {
      "standard": true
    }
  }
}
