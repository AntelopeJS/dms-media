{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 3,
    "anti-slop/no-known-value-widening": 2,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 8,
    "anti-slop/no-unsafe-dictionary-type": 1,
    "anti-slop/require-safety-comment-for-type-assertion": 9,
    "typescript/no-unsafe-argument": 37,
    "typescript/no-unsafe-assignment": 142,
    "typescript/no-unsafe-return": 41,
    "typescript/use-unknown-in-catch-callback-variable": 1
  },
  "oversizeFiles": {}
}
